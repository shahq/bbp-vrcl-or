    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "start": "node --import tsx server.ts",
    "smoke:provider-api": "node scripts/smoke-provider-api.mjs",
    "smoke:ai-api": "node scripts/smoke-ai-api.mjs",
    "smoke:attachments-api": "node scripts/smoke-attachments-api.mjs",
    "smoke:brief-from-uploads": "node scripts/smoke-brief-from-uploads.mjs",
    "smoke:exports-api": "node scripts/smoke-exports-api.mjs",
    "partykit:dev": "partykit dev --config partykit.json --port 1999",
    "partykit:deploy": "partykit deploy",
    "convex:dev": "convex dev",
    "convex:codegen": "convex codegen"
  },
  "dependencies": {
    "@google/genai": "^1.44.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.4.1",
    "docx": "^9.6.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase-admin": "^13.8.0",
    "jszip": "^3.10.1",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "partysocket": "^1.1.16",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "tsx": "^4.21.0",
    "vite": "^6.2.0",
    "convex": "^1.40.0"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "partykit": "^0.0.115",
