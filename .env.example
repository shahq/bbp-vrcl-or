# ==========================================
# Environment files
# ==========================================
#
# .env.local       Local development. Gitignored. Used by `npm run dev`.
#                  Do not set NODE_ENV, PORT, or VITE_API_BASE_URL here for
#                  normal same-origin local dev.
#
# .env.staging     Staging frontend build values. Gitignored. Used by
#                  `npm run build:staging`. Only include browser-safe VITE_* vars.
#
# .env.production  Future production frontend build values. Gitignored.
#
# .env.example     This documented template. Committed to the repo.
#
# Cloud Run runtime secrets/env are configured on the Cloud Run service.
# Dockerfile only provides safe defaults such as NODE_ENV and PORT.

# AI_PROVIDER: Default provider for models that do not imply a provider directly.
# Supported values: "opencode", "google", "openrouter"
AI_PROVIDER="opencode"

# DATA_STORE_PROVIDER: Backend session/card/connection persistence provider.
# Supported values: "sqlite", "firestore", "convex"
DATA_STORE_PROVIDER="sqlite"

# ATTACHMENT_STORE_PROVIDER: Attachment binary + metadata storage provider.
# Supported values: "local", "firebase", "ephemeral"
ATTACHMENT_STORE_PROVIDER="local"

# ADMIN_AUTH_PROVIDER: Admin authentication provider.
# Supported values: "password", "firebase"
ADMIN_AUTH_PROVIDER="password"

# AI_DEFAULT_MODEL: Default model used by server AI routes if the client does not pass one.
AI_DEFAULT_MODEL="minimax-m2.5"

# GOOGLE_API_KEY / GEMINI_API_KEY: Google AI key used for Gemini models.
# Keep either variable name if your deployment platform standardizes on one of them.
GOOGLE_API_KEY="MY_GOOGLE_API_KEY"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENCODE_API_KEY: Key used for Opencode-backed models such as MiniMax through the Opencode proxy.
OPENCODE_API_KEY="MY_OPENCODE_API_KEY"

# OPENROUTER_API_KEY: Key used for OpenRouter-backed models such as "openrouter/auto".
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# OPENAI_API_KEY: Key used for direct OpenAI models such as "gpt-4o-mini".
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# ANTHROPIC_API_KEY / CLAUDE_API_KEY: Key used for direct Claude models.
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"
CLAUDE_API_KEY="MY_CLAUDE_API_KEY"

# CONVEX_URL: Convex deployment URL for DATA_STORE_PROVIDER=convex verification.
# VITE_CONVEX_URL is accepted as a fallback by the server adapter.
CONVEX_URL=""
VITE_CONVEX_URL=""

# FIREBASE_*: Backend Firebase Admin SDK credentials and bucket configuration.
# Required for DATA_STORE_PROVIDER=firestore and ATTACHMENT_STORE_PROVIDER=firebase.
FIREBASE_PROJECT_ID="my-firebase-project"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@example.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET="my-firebase-project.firebasestorage.app"

# ADMIN_PASSWORD: Password for accessing the admin dashboard.
# Default: "shazam!"
ADMIN_PASSWORD="shazam!"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Optional absolute base URL for API requests from the browser.
# Leave unset for same-origin local development. Set this only when the frontend is
# hosted separately from the Express backend, for example Firebase Hosting staging.
VITE_API_BASE_URL="https://api.example.com"

# CORS_ALLOWED_ORIGINS: Comma-separated frontend origins allowed to call the backend.
# Keep localhost entries for development and add Firebase Hosting / staging origins for deployed frontends.
CORS_ALLOWED_ORIGINS="https://example.web.app,https://example.firebaseapp.com"

# PARTYKIT_HOST: The PartyKit host for the Express backend when minting realtime auth.
PARTYKIT_HOST="localhost:1999"

# PARTYKIT_ADMIN_SECRET: Shared secret used to sign and verify admin PartyKit tokens.
PARTYKIT_ADMIN_SECRET="replace-me"

# VITE_PARTYKIT_HOST: The PartyKit host used by the browser client.
VITE_PARTYKIT_HOST="localhost:1999"

# VITE_PARTYKIT_PARTY: Optional PartyKit party name override.
VITE_PARTYKIT_PARTY="main"
